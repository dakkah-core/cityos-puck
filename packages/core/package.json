{
  "name": "@cityos-core/puck",
  "version": "0.23.0-cityos.3",
  "description": "CityOS-owned Puck runtime with a native-session integration boundary",
  "author": "Chris Villa <chris@puckeditor.com>",
  "repository": "dakkah-core/cityos-puck",
  "bugs": "https://github.com/dakkah-core/cityos-puck/issues",
  "homepage": "https://github.com/dakkah-core/cityos-puck",
  "keywords": [
    "puck",
    "visual",
    "editor",
    "react",
    "drag and drop",
    "dnd",
    "page",
    "website",
    "builder",
    "headless",
    "cms",
    "low-code",
    "no-code",
    "javascript",
    "typescript",
    "WYSIWYG"
  ],
  "private": false,
  "main": "./dist/bundle/index.js",
  "types": "./dist/bundle/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/bundle/rsc.d.ts",
        "import": "./dist/bundle/rsc.mjs",
        "require": "./dist/bundle/rsc.js"
      },
      "default": {
        "types": "./dist/bundle/index.d.ts",
        "import": "./dist/bundle/index.mjs",
        "require": "./dist/bundle/index.js"
      }
    },
    "./rsc": {
      "types": "./dist/bundle/rsc.d.ts",
      "import": "./dist/bundle/rsc.mjs",
      "require": "./dist/bundle/rsc.js"
    },
    "./internal": {
      "types": "./dist/bundle/internal.d.ts",
      "import": "./dist/bundle/internal.mjs",
      "require": "./dist/bundle/internal.js"
    },
    "./puck.css": "./dist/bundle/index.css",
    "./no-external.css": "./dist/bundle/no-external.css",
    "./dist/index.css": "./dist/bundle/index.css",
    "./package.json": "./package.json",
    "./cityos": {
      "types": "./dist/cityos.d.ts",
      "import": "./dist/cityos.mjs",
      "require": "./dist/cityos.js"
    }
  },
  "typesVersions": {
    "*": {
      "rsc": [
        "./dist/bundle/rsc.d.ts"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "lint": "eslint \"**/*.ts*\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup bundle/index.ts bundle/rsc.tsx bundle/no-external.ts bundle/internal.ts cityos.ts",
    "test": "node ../../scripts/toolchains/typecheck.mjs --noEmit && jest",
    "prepare": "node -e \"require('fs').copyFileSync('../../README.md','README.md')\" && node ../../scripts/toolchains/run-pinned-pnpm.mjs build",
    "postpublish": "node -e \"require('fs').rmSync('README.md',{force:true})\"",
    "typecheck": "node ../../scripts/toolchains/typecheck.mjs --noEmit"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@juggle/resize-observer": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/deep-diff": "catalog:",
    "@types/jest": "catalog:",
    "@types/object-hash": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "css-box-model": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-custom": "workspace:*",
    "identity-obj-proxy": "catalog:",
    "jest": "catalog:",
    "jest-environment-jsdom": "catalog:",
    "lucide-react": "catalog:",
    "postcss": "catalog:",
    "postcss-modules": "catalog:",
    "ts-jest": "catalog:",
    "tsconfig": "workspace:*",
    "tsup": "catalog:",
    "tsup-config": "workspace:*",
    "typescript": "catalog:",
    "typescript-api": "catalog:",
    "@types/node": "catalog:",
    "happy-dom": "catalog:"
  },
  "dependencies": {
    "@dnd-kit/abstract": "catalog:",
    "@dnd-kit/dom": "catalog:",
    "@dnd-kit/geometry": "catalog:",
    "@dnd-kit/helpers": "catalog:",
    "@dnd-kit/react": "catalog:",
    "@dnd-kit/state": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-blockquote": "catalog:",
    "@tiptap/extension-bold": "catalog:",
    "@tiptap/extension-code": "catalog:",
    "@tiptap/extension-code-block": "catalog:",
    "@tiptap/extension-document": "catalog:",
    "@tiptap/extension-hard-break": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-horizontal-rule": "catalog:",
    "@tiptap/extension-italic": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-list": "catalog:",
    "@tiptap/extension-paragraph": "catalog:",
    "@tiptap/extension-strike": "catalog:",
    "@tiptap/extension-text": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "deep-diff": "catalog:",
    "fast-equals": "catalog:",
    "flat": "catalog:",
    "object-hash": "catalog:",
    "react-hotkeys-hook": "catalog:",
    "use-debounce": "catalog:",
    "zustand": "catalog:",
    "classnames": "catalog:",
    "@dnd-kit/collision": "catalog:",
    "@tiptap/static-renderer": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:peers"
  }
}
