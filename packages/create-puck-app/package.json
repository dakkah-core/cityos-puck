{
  "name": "create-puck-app",
  "version": "0.23.0",
  "author": "Chris Villa <chris@puckeditor.com>",
  "repository": "puckeditor/puck",
  "bugs": "https://github.com/puckeditor/puck/issues",
  "homepage": "https://puckeditor.com",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-puck-app": "./index.js"
  },
  "files": [
    "templates",
    "index.js",
    "template-file.mjs",
    "manifest-catalog.js",
    "bootstrap-catalog.js",
    "dependency-catalog.yaml",
    "core-package.json",
    "workspace-package.json",
    "node-typescript.json",
    "bootstrap-integration.js",
    "plugin-ai-peer.cjs",
    "plugin-ai-contract.json",
    "patches",
    "toolchain.cjs",
    "pinned-pnpm.mjs"
  ],
  "scripts": {
    "generate": "node scripts/generate.js",
    "prepack": "node -e \"const fs=require('node:fs'); for (const path of ['../../recipes','templates']) if (!fs.statSync(path,{throwIfNoEntry:false})?.isDirectory()) throw new Error('Missing required create-puck-app input directory: '+path+'. Restore the checkout inputs before packing.')\" && node scripts/generate.js",
    "removeGitignore": "mv templates/.gitignore templates/gitignore",
    "restoreGitignore": "mv templates/gitignore templates/.gitignore"
  },
  "dependencies": {
    "commander": "catalog:",
    "glob": "catalog:",
    "handlebars": "catalog:",
    "inquirer": "catalog:",
    "prettier": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  }
}
