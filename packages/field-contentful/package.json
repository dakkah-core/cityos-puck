    "typecheck": "node ../../scripts/toolchains/typecheck.mjs --noEmit"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@puckeditor/core": "workspace:@cityos-core/puck@*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "contentful": "catalog:",
    "eslint": "catalog:",
    "eslint-config-custom": "workspace:*",
    "tsconfig": "workspace:*",
    "tsup": "catalog:",
    "tsup-config": "workspace:*",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "contentful": "catalog:peers",
    "react": "catalog:peers"
  }
}
