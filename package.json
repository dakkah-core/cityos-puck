{
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=demo",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,mdx,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,md,mdx,css}\"",
    "release": "node scripts/toolchains/run-pinned-pnpm.mjs release:prepare && node scripts/toolchains/run-pinned-pnpm.mjs changelog && node scripts/toolchains/run-pinned-pnpm.mjs release-commit",
    "release:prepare": "git fetch --tags && conventional-recommended-bump -p angular | xargs node scripts/toolchains/run-pinned-pnpm.mjs version:auto $1",
    "release:canary": "node scripts/toolchains/run-pinned-pnpm.mjs release:prepare && node scripts/get-unstable-version canary | xargs node scripts/toolchains/run-pinned-pnpm.mjs version:auto $1",
    "release-commit": "git add -u && git commit -m \"release: v${npm_package_version}\"",
    "smoke": "node scripts/e2e/smoke.mjs",
    "test": "turbo run test",
    "version": "lerna version --force-publish -y --no-push --no-changelog --no-git-tag-version $npm_package_version",
    "version:auto": "node scripts/toolchains/run-pinned-pnpm.mjs version --no-git-tag-version --no-git-checks $1",
    "changelog": "node scripts/create-changelog",
    "typecheck": "turbo run typecheck",
    "test:source": "node --test scripts/cityos/*.test.mjs",
    "toolchain:check": "node scripts/toolchains/project-toolchain.mjs --check",
    "toolchain:project": "node scripts/toolchains/project-toolchain.mjs --write"
  },
  "devDependencies": {
    "asciichart": "catalog:",
    "conventional-changelog-angular": "catalog:",
    "conventional-recommended-bump": "catalog:",
    "eslint": "catalog:",
    "eslint-config-custom": "workspace:*",
    "lerna": "catalog:",
    "prettier": "catalog:",
    "puppeteer": "catalog:",
    "rimraf": "catalog:",
    "standard-changelog": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:"
  },
  "name": "puck-repo",
  "packageManager": "pnpm@12.14.0",
  "version": "0.23.0",
  "engines": {
    "node": ">=26.0.0 <27.0.0",
    "pnpm": ">=12.0.0 <13.0.0"
  }
}
