{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "globalEnv": [
    "NEXT_PUBLIC_PLAUSIBLE_DATA_DOMAIN",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_IS_LATEST",
    "NEXT_PUBLIC_IS_CANARY",
    "VERCEL_GIT_COMMIT_REF",
    "NEXT_PUBLIC_BASE_URL",
    "NODE_ENV",
    "PUPPETEER_EXECUTABLE_PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@cityos-core/puck#build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "docs#build": {
      "cache": false,
      "env": ["PUCK_DOCS_NEXT_DIST_DIR"],
      "dependsOn": ["^build", "@cityos-core/puck#build"]
    },
    "demo#build": {
      "cache": false,
      "dependsOn": ["^build", "@cityos-core/puck#build"]
    },
    "next-recipe#build": {
      "cache": false,
      "dependsOn": ["^build", "@cityos-core/puck#build"]
    },
    "next-ai-recipe#build": {
      "cache": false,
      "dependsOn": ["^build", "@cityos-core/puck#build"]
    },
    "react-router-recipe#build": {
      "dependsOn": ["^build", "@cityos-core/puck#build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "react-router-ai-recipe#build": {
      "dependsOn": ["^build", "@cityos-core/puck#build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "@cityos-core/puck#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "tsconfig#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "tsup-config#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "eslint-config-custom#build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "docs#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "demo#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "next-recipe#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "next-ai-recipe#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "react-router-recipe#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "react-router-ai-recipe#typecheck": {
      "cache": false,
      "dependsOn": ["^build"]
    }
  }
}
