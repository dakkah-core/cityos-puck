+function resolveReactPath(basedir) {
+  const options = { basedir, preserveSymlinks: false };
+  const candidates = new Set();
+  return resolve.sync('react', {
+    ...options,
+    packageIterator(request, start, thunk) {
+      const directories = thunk();
+      directories.forEach((directory) => candidates.add(path.resolve(directory)));
+      return directories;
+    },
+    packageFilter(pkg, directory) {
+      if (!candidates.has(path.resolve(directory)) || !pkg.main || typeof pkg.main !== 'string') {
+        return pkg;
+      }
+      const main = pkg.main === '.' || pkg.main === './' ? 'index' : pkg.main;
+      let entry;
+      try {
+        entry = resolve.sync(path.resolve(directory, main), options);
+      } catch (e) {}
+      if (!entry) {
+        try {
+          entry = resolve.sync(path.resolve(directory, 'index'), options);
+        } catch (e) {}
+      }
+      if (!entry) {
+        const error = new Error(`Cannot find module '${path.resolve(directory, main)}'. Please verify that the package.json has a valid "main" entry`);
+        error.code = 'INCORRECT_PACKAGE_MAIN';
+        throw error;
+      }
+      return pkg;
+    },
+  });
+}
