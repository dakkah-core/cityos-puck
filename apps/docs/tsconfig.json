{
  "extends": "./tsconfig/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/puck": [
        "../../packages/core/index.ts"
      ],
      "@/core": [
        "../../packages/core/index.ts"
      ],
      "@/core/*": [
        "../../packages/core/*"
      ],
      "@/plugin-heading-analyzer": [
        "../../packages/plugin-heading-analyzer"
      ],
      "@/plugin-heading-analyzer/*": [
        "../../packages/plugin-heading-analyzer/*"
      ],
      "@/docs/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "content/index.mdx"
  ],
  "exclude": [
    "node_modules"
  ]
}
